# Pasta de dados alternativa (testes/portátil)
LEGACY_DATA_DIR=
# Pasta com ffmpeg.exe/ffprobe.exe (opcional; padrão resources/bin/win32-x64)
LEGACY_FFMPEG_DIR=
# Verificação do download do FFmpeg
FFMPEG_SHA256=
# Assinatura do instalador (somente no ambiente de build)
CSC_LINK=
CSC_KEY_PASSWORD=
# Apify opcional: prefira salvar a chave protegida pela UI em Integrações.
# Alternativa: exporte no ambiente do processo antes de iniciar (não usar prefixo VITE_).
APIFY_TOKEN=
